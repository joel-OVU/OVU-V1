# PostHog (server-side event forwarding for server.ts / `npm start`)
# Project API key from PostHog → Project settings.
POSTHOG_API_KEY="phc_your_project_key"

# PostHog host. EU cloud shown; use https://us.i.posthog.com for US cloud.
POSTHOG_HOST="https://eu.i.posthog.com"

# Port for `npm start` (optional, defaults to 3000).
PORT=3000
